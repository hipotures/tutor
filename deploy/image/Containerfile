# The fork's image for HomeStack, published by .github/workflows/tutor-image.yml.
# Build from the repository root:
#
#   docker build -f deploy/image/Containerfile -t tutor .
#
# Based on docker/Dockerfile.alpine (amd64, SQLite only). The runtime contract
# (persistent /home/app, port, health check) is in deploy/image/README.md and
# .homestack/tutor.yaml.

FROM --platform=linux/amd64 docker.io/vaultwarden/web-vault@sha256:632375471c7c06a799335cd74dfeaef63f92f45f9cd322c337ae7ad70081e48a AS vault

FROM --platform=linux/amd64 ghcr.io/blackdex/rust-musl:x86_64-musl-stable-1.99.0 AS build
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV CARGO_HOME="/root/.cargo" \
    USER="root"
RUN rustup set profile minimal \
    && rustup target add x86_64-unknown-linux-musl
WORKDIR /app
# Dependencies first, in their own layer, so source changes rebuild only the
# application.
RUN cargo init --bin --name vaultwarden .
COPY ./Cargo.* ./rust-toolchain.toml ./build.rs ./
COPY ./macros ./macros
ARG DB=sqlite,enable_mimalloc
RUN cargo build --features ${DB} --release --target x86_64-unknown-linux-musl \
    && find . -not -path "./target*" -delete
COPY . .
ARG VW_VERSION
RUN touch build.rs src/main.rs \
    && cargo build --features ${DB} --release --target x86_64-unknown-linux-musl

FROM docker.io/library/alpine:3.24
ENV ROCKET_PROFILE="release" \
    ROCKET_ADDRESS=0.0.0.0 \
    ROCKET_PORT=80 \
    SSL_CERT_DIR=/etc/ssl/certs \
    DATA_FOLDER=/home/app/data
# /home/app stays empty in the image: the persistent volume is mounted over it.
RUN mkdir -p /home/app \
    && apk --no-cache add ca-certificates curl openssl tzdata
EXPOSE 80
WORKDIR /
COPY docker/healthcheck.sh docker/start.sh deploy/image/entrypoint.sh /
COPY --from=vault /web-vault ./web-vault
COPY --from=build /app/target/x86_64-unknown-linux-musl/release/vaultwarden .
HEALTHCHECK --interval=60s --timeout=10s CMD ["/healthcheck.sh"]
ENTRYPOINT ["/entrypoint.sh"]
